# --- Stub + modular homing path (current component names) ---
#
# Layers:
#   1) cia402_homing     -> homing manager; outputs start-out (bit4 request)
#   2) cia402_cw_compose -> cw-final = cw-pds | (start4 ? 0x10 : 0)
#   3) cia402_stub       -> simulated CiA402 drive
#
# This file is intentionally "semi-modular":
# - base PDS controlword is fixed locally with setp cwcomp.cw-pds 0x000F
# - it does NOT load cia402_pds
#
# For the full modular stack with PDS manager, use:
#   hal/stub_test_modular_pds.hal

loadrt cia402_stub       names=stub
loadrt cia402_homing     names=ut
loadrt cia402_cw_compose names=cwcomp

addf ut.update     servo-thread
addf cwcomp.update servo-thread
addf stub.update   servo-thread

# ------------------------------------------------------------------
# --- Fixed base controlword for this simplified test
# ------------------------------------------------------------------

setp cwcomp.cw-pds 0x000F

# ------------------------------------------------------------------
# --- Homing adapter -> compose -> stub
# ------------------------------------------------------------------

net start4 ut.start-out    => cwcomp.start4
net cw     cwcomp.cw-final => stub.in-controlword
net om     ut.om           => stub.in-opmode
net tp     ut.tp           => stub.in-target-position

# ------------------------------------------------------------------
# --- Stub -> homing adapter
# ------------------------------------------------------------------

net sw  stub.out-statusword      => ut.sw
net omd stub.out-opmode-display  => ut.omd
net ap  stub.out-actual-position => ut.ap

# ------------------------------------------------------------------
# --- Homing adapter setup
# ------------------------------------------------------------------

setp ut.enable TRUE
setp ut.scale  1000
setp ut.cmd    0
setp ut.hold   TRUE

setp ut.done-m      0x1400
setp ut.done-v      0x1400
setp ut.start-pulse 1

# ------------------------------------------------------------------
# --- Stub setup (SIM parameters)
# ------------------------------------------------------------------

setp stub.opmode-apply-delay-cycles 20
setp stub.homing-run-cycles         50
setp stub.done-hold-cycles          30