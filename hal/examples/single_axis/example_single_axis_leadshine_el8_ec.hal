# hal/examples/single_axis/example_single_axis_leadshine_el8_ec.hal
#
# Single-axis pilot wrapper for Leadshine EL8-EC.
#
# IMPORTANT
# - keep this wrapper thin
# - do not duplicate core loading here
# - do not duplicate topology logic here
# - the active integration point remains the validated single-axis topology
#
# PROFILE
# - leadshine_el8_ec (CiA402 EtherCAT)
#
# ROLE
# - binds the validated semantic pipeline to the EL8-EC backend binding layer
#
# NOTE
# - real hardware binding occurs in:
#   hal/adapters/leadshine_el8_ec_single_axis_binding.hal
# - this file must remain transport-agnostic

source hal/topology/single_axis/single_axis_base.hal
source hal/adapters/leadshine_el8_ec_single_axis_binding.hal
