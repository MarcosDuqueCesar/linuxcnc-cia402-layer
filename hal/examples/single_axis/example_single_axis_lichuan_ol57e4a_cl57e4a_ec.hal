# hal/examples/single_axis/example_single_axis_lichuan_ol57e4a_cl57e4a_ec.hal
#
# Single-axis pilot wrapper for Lichuan OL57E4A / CL57E4A EtherCAT.
#
# IMPORTANT
# - keep this wrapper thin
# - do not duplicate core loading here
# - do not duplicate topology logic here
# - the active integration point remains the validated single-axis topology
#
# PROFILE
# - lichuan_ol57e4a_cl57e4a_ec (CiA402 EtherCAT)
#
# ROLE
# - binds the validated semantic pipeline to the Lichuan backend binding layer
#
# NOTE
# - real hardware binding occurs in:
#   hal/adapters/lichuan_ol57e4a_cl57e4a_ec_single_axis_binding.hal
# - this file must remain transport-agnostic

source hal/topology/single_axis/single_axis_base.hal
source hal/adapters/lichuan_ol57e4a_cl57e4a_ec_single_axis_binding.hal
