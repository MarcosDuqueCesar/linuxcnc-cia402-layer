# hal/adapters/delta_ec_single_axis_binding.hal
#
# Delta EtherCAT single-axis real-binding scaffold
#
# STATUS
# - structural scaffold aligned with project binding standard
# - adapter contract preserved exactly
# - exact runtime HAL pin names still require confirmation on the real machine
# - NOT hardware-validated in this repository stage
#
# IMPORTANT
# - do NOT change core
# - do NOT change topology
# - do NOT bypass mux/cw
# - do NOT create parallel writers
# - do NOT guess backend pin names as validated facts
#
# FRAMEWORK CONTRACT
#
# CIA402 OBJECT CONTRACT
#   0x6040 controlword
#   0x6060 modes of operation command
#   0x607A target position
#   0x6041 statusword
#   0x6061 modes of operation display
#   0x6064 actual position
#
# AXIS CONVENTION
# - single-axis pilot = logical axis X
# - semantic instance = adapter
#
# IMPORTANT
# The names below under "EXPECTED LCEC SHAPE" are placeholders only.
# They are NOT hardware-validated until confirmed by runtime evidence on a real machine.

# ----------------------------------------------------------------------
# RUNTIME REGISTRY — FILL/CONFIRM ON REAL MACHINE
# ----------------------------------------------------------------------
# REAL_PIN_6040 = lcec.0.<slave>.controlword
# REAL_PIN_6060 = lcec.0.<slave>.opmode
# REAL_PIN_607A = lcec.0.<slave>.target-position
# REAL_PIN_6041 = lcec.0.<slave>.statusword
# REAL_PIN_6061 = lcec.0.<slave>.opmode-display
# REAL_PIN_6064 = lcec.0.<slave>.actual-position
#
# Alternate names sometimes seen:
#   modes-of-operation
#   modes-of-operation-display
#   position-actual-value

# ----------------------------------------------------------------------
# DEFAULT PROJECT-SIDE SIGNALS
# ----------------------------------------------------------------------
newsig delta-x-controlword     u32
newsig delta-x-opmode-cmd      s32
newsig delta-x-target-position s32
newsig delta-x-statusword      u32
newsig delta-x-opmode-display  s32
newsig delta-x-actual-position s32

# ----------------------------------------------------------------------
# SEMANTIC SIDE <-> PROJECT-SIDE TRANSPORT SURFACE
# ----------------------------------------------------------------------


# ----------------------------------------------------------------------
# EXPECTED LCEC SHAPE — UNCOMMENT AFTER REAL RUNTIME CONFIRMATION
# ----------------------------------------------------------------------
# net delta-x-controlword-rt      delta-x-controlword     => lcec.0.<slave>.controlword
# net delta-x-opmode-cmd-rt       delta-x-opmode-cmd      => lcec.0.<slave>.opmode
# net delta-x-target-position-rt  delta-x-target-position => lcec.0.<slave>.target-position
#
# net delta-x-statusword-rt       lcec.0.<slave>.statusword      => delta-x-statusword
# net delta-x-opmode-display-rt   lcec.0.<slave>.opmode-display  => delta-x-opmode-display
# net delta-x-actual-position-rt  lcec.0.<slave>.actual-position => delta-x-actual-position

# ----------------------------------------------------------------------
# ALTERNATE LCEC SHAPE — USE ONLY IF RUNTIME EXPORTS LONGER NAMES
# ----------------------------------------------------------------------
# net delta-x-controlword-rt      delta-x-controlword     => lcec.0.<slave>.controlword
# net delta-x-opmode-cmd-rt       delta-x-opmode-cmd      => lcec.0.<slave>.modes-of-operation
# net delta-x-target-position-rt  delta-x-target-position => lcec.0.<slave>.target-position
#
# net delta-x-statusword-rt       lcec.0.<slave>.statusword                 => delta-x-statusword
# net delta-x-opmode-display-rt   lcec.0.<slave>.modes-of-operation-display => delta-x-opmode-display
# net delta-x-actual-position-rt  lcec.0.<slave>.position-actual-value      => delta-x-actual-position

# ----------------------------------------------------------------------
# OPERATIONAL RULE
# ----------------------------------------------------------------------
# Keep the framework authority unchanged:
#
# Keep the feedback return path unchanged:
#
# No direct backend hookup to cw/mux/pds/mcsp.
#
# END OF FILE
