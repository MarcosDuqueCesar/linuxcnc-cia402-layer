# hal/adapters/lichuan_ol57e4a_cl57e4a_ec_single_axis_binding.hal
#
# Lichuan OL57E4A / CL57E4A EtherCAT single-axis real-binding scaffold
#
# STATUS
# - derived from project profile assumptions for CiA402 EtherCAT integration
# - near-final LCEC-oriented binding scaffold
# - exact runtime HAL pin names still require confirmation on the real machine
#
# IMPORTANT
# - do NOT change core
# - do NOT change topology
# - do NOT bypass mux/cw
# - do NOT create parallel writers
# - do NOT guess backend pin names as validated facts
#
# FRAMEWORK CONTRACT
#   adapter.in-controlword
#   adapter.in-opmode
#   adapter.in-target-position
#   adapter.out-statusword
#   adapter.out-opmode-display
#   adapter.out-actual-position
#
# LICHUAN OBJECT CONTRACT
#   0x6040 controlword
#   0x6060 modes of operation command
#   0x607A target position
#   0x6041 statusword
#   0x6061 modes of operation display
#   0x6064 actual position
#
# AXIS CONVENTION
# - single-axis pilot = logical axis X
# - semantic instance = adapter
#
# IMPORTANT
# The names below under "EXPECTED LCEC SHAPE" are the closest practical guess
# based on common CiA402/LCEC naming style.
# They are NOT hardware-validated until confirmed by:
#   halcmd show pin | grep lcec

# ----------------------------------------------------------------------
# RUNTIME REGISTRY — FILL/CONFIRM ON REAL MACHINE
# ----------------------------------------------------------------------
# REAL_PIN_6040 = lcec.0.<slave>.controlword
# REAL_PIN_6060 = lcec.0.<slave>.opmode
# REAL_PIN_607A = lcec.0.<slave>.target-position
# REAL_PIN_6041 = lcec.0.<slave>.statusword
# REAL_PIN_6061 = lcec.0.<slave>.opmode-display
# REAL_PIN_6064 = lcec.0.<slave>.actual-position
#
# Alternate names sometimes seen:
#   modes-of-operation
#   modes-of-operation-display
#   position-actual-value

# ----------------------------------------------------------------------
# DEFAULT PROJECT-SIDE SIGNALS
# ----------------------------------------------------------------------
newsig lichuan-x-controlword     u32
newsig lichuan-x-opmode-cmd      s32
newsig lichuan-x-target-position s32
newsig lichuan-x-statusword      u32
newsig lichuan-x-opmode-display  s32
newsig lichuan-x-actual-position s32

# ----------------------------------------------------------------------
# SEMANTIC SIDE <-> PROJECT-SIDE TRANSPORT SURFACE
# ----------------------------------------------------------------------
net lichuan-x-controlword-cmd      adapter.in-controlword      => lichuan-x-controlword
net lichuan-x-opmode-cmd-sig       adapter.in-opmode           => lichuan-x-opmode-cmd
net lichuan-x-target-position-cmd  adapter.in-target-position  => lichuan-x-target-position

net lichuan-x-statusword-fb        lichuan-x-statusword       => adapter.out-statusword
net lichuan-x-opmode-display-fb    lichuan-x-opmode-display   => adapter.out-opmode-display
net lichuan-x-actual-position-fb   lichuan-x-actual-position  => adapter.out-actual-position

# ----------------------------------------------------------------------
# EXPECTED LCEC SHAPE — UNCOMMENT AFTER REAL RUNTIME CONFIRMATION
# ----------------------------------------------------------------------
# net lichuan-x-controlword-rt      lichuan-x-controlword     => lcec.0.<slave>.controlword
# net lichuan-x-opmode-cmd-rt       lichuan-x-opmode-cmd      => lcec.0.<slave>.opmode
# net lichuan-x-target-position-rt  lichuan-x-target-position => lcec.0.<slave>.target-position
#
# net lichuan-x-statusword-rt       lcec.0.<slave>.statusword      => lichuan-x-statusword
# net lichuan-x-opmode-display-rt   lcec.0.<slave>.opmode-display  => lichuan-x-opmode-display
# net lichuan-x-actual-position-rt  lcec.0.<slave>.actual-position => lichuan-x-actual-position

# ----------------------------------------------------------------------
# ALTERNATE LCEC SHAPE — USE ONLY IF RUNTIME EXPORTS LONGER NAMES
# ----------------------------------------------------------------------
# net lichuan-x-controlword-rt      lichuan-x-controlword     => lcec.0.<slave>.controlword
# net lichuan-x-opmode-cmd-rt       lichuan-x-opmode-cmd      => lcec.0.<slave>.modes-of-operation
# net lichuan-x-target-position-rt  lichuan-x-target-position => lcec.0.<slave>.target-position
#
# net lichuan-x-statusword-rt       lcec.0.<slave>.statusword                 => lichuan-x-statusword
# net lichuan-x-opmode-display-rt   lcec.0.<slave>.modes-of-operation-display => lichuan-x-opmode-display
# net lichuan-x-actual-position-rt  lcec.0.<slave>.position-actual-value      => lichuan-x-actual-position

# ----------------------------------------------------------------------
# OPERATIONAL RULE
# ----------------------------------------------------------------------
# Keep the framework authority unchanged:
#   cw  -> adapter.in-controlword
#   mux -> adapter.in-opmode
#   mux -> adapter.in-target-position
#
# Keep the feedback return path unchanged:
#   adapter.out-statusword
#   adapter.out-opmode-display
#   adapter.out-actual-position
#
# No direct backend hookup to cw/mux/pds/mcsp.
#
# END OF FILE
