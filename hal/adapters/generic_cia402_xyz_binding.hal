# hal/adapters/generic_cia402_xyz_binding.hal
#
# Generic CiA402 EtherCAT XYZ experimental binding scaffold
#
# STATUS
# - generic multi-axis scaffold
# - intended to prevent ad-hoc mixed wiring by third parties
# - experimental
# - not runtime validated as a generic drop-in recipe
#
# IMPORTANT
# - do NOT change core
# - do NOT change topology
# - do NOT bypass mux/cw
# - do NOT create parallel writers
# - do NOT mix axis ownership
# - do NOT guess backend pin names as validated facts
#
# FRAMEWORK CONTRACT PER AXIS
#   adapter_<axis>.in-controlword
#   adapter_<axis>.in-opmode
#   adapter_<axis>.in-target-position
#   adapter_<axis>.out-statusword
#   adapter_<axis>.out-opmode-display
#   adapter_<axis>.out-actual-position
#
# GENERIC CIA402 OBJECT CONTRACT PER AXIS
#   0x6040 controlword
#   0x6060 modes of operation command
#   0x607A target position
#   0x6041 statusword
#   0x6061 modes of operation display
#   0x6064 actual position
#
# AXIS CONVENTION
# - X semantic instance = adapter_x
# - Y semantic instance = adapter_y
# - Z semantic instance = adapter_z
#
# TRANSPORT ASSUMPTION
# - EtherCAT / LCEC-like naming expected, but NOT assumed as validated
# - exact runtime names must be confirmed on the machine
#
# CONFIRMATION METHOD
#   halcmd show pin | grep lcec
#
# DESIGN GOAL
# - provide a clean, per-axis binding surface
# - avoid "everything mixed in one file without structure"
# - let third parties fill only the runtime transport side

# ----------------------------------------------------------------------
# RUNTIME REGISTRY — FILL/CONFIRM ON REAL MACHINE
# ----------------------------------------------------------------------
# AXIS X
# REAL_X_6040 =
# REAL_X_6060 =
# REAL_X_607A =
# REAL_X_6041 =
# REAL_X_6061 =
# REAL_X_6064 =
#
# AXIS Y
# REAL_Y_6040 =
# REAL_Y_6060 =
# REAL_Y_607A =
# REAL_Y_6041 =
# REAL_Y_6061 =
# REAL_Y_6064 =
#
# AXIS Z
# REAL_Z_6040 =
# REAL_Z_6060 =
# REAL_Z_607A =
# REAL_Z_6041 =
# REAL_Z_6061 =
# REAL_Z_6064 =
#
# COMMON EXPECTED LCEC-LIKE SHAPE
#   lcec.0.<slave>.controlword
#   lcec.0.<slave>.opmode
#   lcec.0.<slave>.target-position
#   lcec.0.<slave>.statusword
#   lcec.0.<slave>.opmode-display
#   lcec.0.<slave>.actual-position
#
# ALTERNATE NAMES SOMETIMES SEEN
#   modes-of-operation
#   modes-of-operation-display
#   position-actual-value

# ======================================================================
# AXIS X
# ======================================================================

# ----------------------------------------------------------------------
# PROJECT-SIDE SIGNALS
# ----------------------------------------------------------------------
newsig xyz-x-controlword     u32
newsig xyz-x-opmode-cmd      s32
newsig xyz-x-target-position s32
newsig xyz-x-statusword      u32
newsig xyz-x-opmode-display  s32
newsig xyz-x-actual-position s32

# ----------------------------------------------------------------------
# SEMANTIC SIDE <-> PROJECT-SIDE TRANSPORT SURFACE
# ----------------------------------------------------------------------
net xyz-x-controlword-cmd      adapter_x.in-controlword      => xyz-x-controlword
net xyz-x-opmode-cmd-sig       adapter_x.in-opmode           => xyz-x-opmode-cmd
net xyz-x-target-position-cmd  adapter_x.in-target-position  => xyz-x-target-position

net xyz-x-statusword-fb        xyz-x-statusword             => adapter_x.out-statusword
net xyz-x-opmode-display-fb    xyz-x-opmode-display         => adapter_x.out-opmode-display
net xyz-x-actual-position-fb   xyz-x-actual-position        => adapter_x.out-actual-position

# ----------------------------------------------------------------------
# EXPECTED LCEC SHAPE — AXIS X
# ----------------------------------------------------------------------
# Uncomment only after runtime confirmation.
#
# net xyz-x-controlword-rt      xyz-x-controlword     => lcec.0.<slave_x>.controlword
# net xyz-x-opmode-cmd-rt       xyz-x-opmode-cmd      => lcec.0.<slave_x>.opmode
# net xyz-x-target-position-rt  xyz-x-target-position => lcec.0.<slave_x>.target-position
#
# net xyz-x-statusword-rt       lcec.0.<slave_x>.statusword      => xyz-x-statusword
# net xyz-x-opmode-display-rt   lcec.0.<slave_x>.opmode-display  => xyz-x-opmode-display
# net xyz-x-actual-position-rt  lcec.0.<slave_x>.actual-position => xyz-x-actual-position

# ----------------------------------------------------------------------
# ALTERNATE LCEC SHAPE — AXIS X
# ----------------------------------------------------------------------
# net xyz-x-controlword-rt      xyz-x-controlword     => lcec.0.<slave_x>.controlword
# net xyz-x-opmode-cmd-rt       xyz-x-opmode-cmd      => lcec.0.<slave_x>.modes-of-operation
# net xyz-x-target-position-rt  xyz-x-target-position => lcec.0.<slave_x>.target-position
#
# net xyz-x-statusword-rt       lcec.0.<slave_x>.statusword                 => xyz-x-statusword
# net xyz-x-opmode-display-rt   lcec.0.<slave_x>.modes-of-operation-display => xyz-x-opmode-display
# net xyz-x-actual-position-rt  lcec.0.<slave_x>.position-actual-value      => xyz-x-actual-position

