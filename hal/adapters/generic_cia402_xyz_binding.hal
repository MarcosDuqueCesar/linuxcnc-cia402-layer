# ----------------------------------------------------------------------
# EXPECTED LCEC SHAPE — AXIS Z
# ----------------------------------------------------------------------
# net xyz-z-controlword-rt      xyz-z-controlword     => lcec.0.<slave_z>.controlword
# net xyz-z-opmode-cmd-rt       xyz-z-opmode-cmd      => lcec.0.<slave_z>.opmode
# net xyz-z-target-position-rt  xyz-z-target-position => lcec.0.<slave_z>.target-position
#
