net xyz-y-target-position-cmd  adapter_y.in-target-position  => xyz-y-target-position

net xyz-y-statusword-fb        xyz-y-statusword             => adapter_y.out-statusword
net xyz-y-opmode-display-fb    xyz-y-opmode-display         => adapter_y.out-opmode-display
net xyz-y-actual-position-fb   xyz-y-actual-position        => adapter_y.out-actual-position

# ----------------------------------------------------------------------
# EXPECTED LCEC SHAPE — AXIS Y
# ----------------------------------------------------------------------
# net xyz-y-controlword-rt      xyz-y-controlword     => lcec.0.<slave_y>.controlword
# net xyz-y-opmode-cmd-rt       xyz-y-opmode-cmd      => lcec.0.<slave_y>.opmode
# net xyz-y-target-position-rt  xyz-y-target-position => lcec.0.<slave_y>.target-position
#
# net xyz-y-statusword-rt       lcec.0.<slave_y>.statusword      => xyz-y-statusword
# net xyz-y-opmode-display-rt   lcec.0.<slave_y>.opmode-display  => xyz-y-opmode-display
# net xyz-y-actual-position-rt  lcec.0.<slave_y>.actual-position => xyz-y-actual-position

# ----------------------------------------------------------------------
# ALTERNATE LCEC SHAPE — AXIS Y
# ----------------------------------------------------------------------
# net xyz-y-controlword-rt      xyz-y-controlword     => lcec.0.<slave_y>.controlword
# net xyz-y-opmode-cmd-rt       xyz-y-opmode-cmd      => lcec.0.<slave_y>.modes-of-operation
# net xyz-y-target-position-rt  xyz-y-target-position => lcec.0.<slave_y>.target-position
#
# net xyz-y-statusword-rt       lcec.0.<slave_y>.statusword                 => xyz-y-statusword
# net xyz-y-opmode-display-rt   lcec.0.<slave_y>.modes-of-operation-display => xyz-y-opmode-display
# net xyz-y-actual-position-rt  lcec.0.<slave_y>.position-actual-value      => xyz-y-actual-position

