# --- Multi-axis modular CiA402 validation harness (X + Y) ---
#
# Goal:
# - validate scale-up from single-axis to two independent axes
# - keep one complete semantic/supervision pipeline per axis
# - do NOT introduce gantry here
#
# Core rule:
# - isolation per axis
# - only machine policy inputs are shared globally:
#   estop-ok, machine-on, drives-ready

# ------------------------------------------------------------------
# --- LOADRT: one full stack per axis
# ------------------------------------------------------------------

loadrt machine_safety_gate      names=msg_x,msg_y
loadrt cia402_pds               names=pds_x,pds_y
loadrt cia402_homing            names=ut_x,ut_y
loadrt cia402_motion_csp        names=mcsp_x,mcsp_y
loadrt cia402_axis_semantic_mux names=mux_x,mux_y
loadrt cia402_invariant_monitor names=invmon_x,invmon_y
loadrt cia402_cw_compose        names=cw_x,cw_y
loadrt cia402_backend_adapter   names=adapter_x,adapter_y
loadrt cia402_motion_watchdog   names=motion_wd_x,motion_wd_y
loadrt cia402_home_watchdog     names=home_wd_x,home_wd_y
loadrt fault_injector_x         names=fault_inj_x,fault_inj_y

loadrt and2                     names=home_gate_x,home_gate_y
loadrt conv_s32_float           names=apf_x,apf_y
loadrt scale                    names=fb_units_x,fb_units_y

# ------------------------------------------------------------------
# --- THREAD ORDER
# ------------------------------------------------------------------

addf msg_x.update       servo-thread
addf msg_y.update       servo-thread

addf pds_x.update       servo-thread
addf pds_y.update       servo-thread

addf home_gate_x        servo-thread
addf home_gate_y        servo-thread

addf ut_x.update        servo-thread
addf ut_y.update        servo-thread

addf mcsp_x.update      servo-thread
addf mcsp_y.update      servo-thread

addf mux_x.update       servo-thread
addf mux_y.update       servo-thread

addf invmon_x.update    servo-thread
addf invmon_y.update    servo-thread

addf cw_x.update        servo-thread
addf cw_y.update        servo-thread

addf adapter_x          servo-thread
addf adapter_y          servo-thread

addf fault_inj_x.update servo-thread
addf fault_inj_y.update servo-thread

addf motion_wd_x.update servo-thread
addf motion_wd_y.update servo-thread

addf home_wd_x.update   servo-thread
addf home_wd_y.update   servo-thread

addf apf_x              servo-thread
addf apf_y              servo-thread

addf fb_units_x         servo-thread
addf fb_units_y         servo-thread

# ------------------------------------------------------------------
# --- GLOBAL MACHINE POLICY SIGNALS
# ------------------------------------------------------------------

newsig estop-ok     bit
newsig machine-on   bit
newsig drives-ready bit

# ------------------------------------------------------------------
# --- PER-AXIS REQUEST SIGNALS
# ------------------------------------------------------------------

newsig home-req-x        bit
newsig motion-req-x      bit
newsig fault-reset-req-x bit

newsig home-req-y        bit
newsig motion-req-y      bit
newsig fault-reset-req-y bit

# ------------------------------------------------------------------
# --- GLOBAL -> MSG per axis
# ------------------------------------------------------------------

net estop-ok     => msg_x.estop-ok     msg_y.estop-ok
net machine-on   => msg_x.machine-on   msg_y.machine-on
net drives-ready => msg_x.drives-ready msg_y.drives-ready

# ------------------------------------------------------------------
# --- AXIS X: requests into policy gate
# ------------------------------------------------------------------

net home-req-x        => msg_x.homing-req      ut_x.home         home_wd_x.home-req
net motion-req-x      => msg_x.motion-req      mcsp_x.motion-req motion_wd_x.motion-req
net fault-reset-req-x => msg_x.fault-reset-req pds_x.fault-reset

# ------------------------------------------------------------------
# --- AXIS Y: requests into policy gate
# ------------------------------------------------------------------

net home-req-y        => msg_y.homing-req      ut_y.home         home_wd_y.home-req
net motion-req-y      => msg_y.motion-req      mcsp_y.motion-req motion_wd_y.motion-req
net fault-reset-req-y => msg_y.fault-reset-req pds_y.fault-reset

# ------------------------------------------------------------------
# --- PLANNER -> CiA402 bridge per axis
# Assumes these signals already exist in opc_validation.hal:
#   xpos-cmd, ypos-cmd
# ------------------------------------------------------------------

net xpos-cmd => ut_x.cmd mcsp_x.pos-cmd motion_wd_x.pos-cmd
net ypos-cmd => ut_y.cmd mcsp_y.pos-cmd motion_wd_y.pos-cmd

# ------------------------------------------------------------------
# --- AXIS X: PDS <-> policy <-> backend
# ------------------------------------------------------------------

newsig sw-raw-x u32
net sw-raw-x         adapter_x.out-statusword => fault_inj_x.sw-in
net sw-x             fault_inj_x.sw-out      => pds_x.sw ut_x.sw
net allow-enable-x   msg_x.allow-enable       => pds_x.allow-enable mcsp_x.enable
net allow-freset-x   msg_x.allow-fault-reset  => pds_x.allow-fault-reset
net allow-motion-x   msg_x.allow-motion       => mcsp_x.allow-motion motion_wd_x.enable
net pds-cw-x         pds_x.cw-pds             => cw_x.cw-pds
net pds-op-enabled-x pds_x.op-enabled         => home_gate_x.in0 mcsp_x.op-enabled motion_wd_x.op-enabled

# ------------------------------------------------------------------
# --- AXIS Y: PDS <-> policy <-> backend
# ------------------------------------------------------------------

newsig sw-raw-y u32
net sw-raw-y         adapter_y.out-statusword => fault_inj_y.sw-in
net sw-y             fault_inj_y.sw-out      => pds_y.sw ut_y.sw
net allow-enable-y   msg_y.allow-enable       => pds_y.allow-enable mcsp_y.enable
net allow-freset-y   msg_y.allow-fault-reset  => pds_y.allow-fault-reset
net allow-motion-y   msg_y.allow-motion       => mcsp_y.allow-motion motion_wd_y.enable
net pds-cw-y         pds_y.cw-pds             => cw_y.cw-pds
net pds-op-enabled-y pds_y.op-enabled         => home_gate_y.in0 mcsp_y.op-enabled motion_wd_y.op-enabled

# ------------------------------------------------------------------
# --- AXIS X: homing gate
# ------------------------------------------------------------------

net allow-homing-x msg_x.allow-homing => home_gate_x.in1
net ut-enable-x    home_gate_x.out    => ut_x.enable

# ------------------------------------------------------------------
# --- AXIS Y: homing gate
# ------------------------------------------------------------------

net allow-homing-y msg_y.allow-homing => home_gate_y.in1
net ut-enable-y    home_gate_y.out    => ut_y.enable

# ------------------------------------------------------------------
# --- AXIS X: backend feedback path
# raw counts -> float -> scale -> machine units
# ------------------------------------------------------------------

net ap-x       adapter_x.out-actual-position => ut_x.ap apf_x.in
net apf-out-x  apf_x.out                     => fb_units_x.in
net fb-units-x fb_units_x.out                => mcsp_x.pos-fb fault_inj_x.pos-fb-in
newsig fb-wd-x float
net fb-wd-x    fault_inj_x.pos-fb-out        => motion_wd_x.pos-fb

# ------------------------------------------------------------------
# --- AXIS Y: backend feedback path
# ------------------------------------------------------------------

net ap-y       adapter_y.out-actual-position => ut_y.ap apf_y.in
net apf-out-y  apf_y.out                     => fb_units_y.in
net fb-units-y fb_units_y.out                => mcsp_y.pos-fb fault_inj_y.pos-fb-in
newsig fb-wd-y float
net fb-wd-y    fault_inj_y.pos-fb-out        => motion_wd_y.pos-fb

# ------------------------------------------------------------------
# --- AXIS X: opmode display path
# ------------------------------------------------------------------

net omd-x adapter_x.out-opmode-display => ut_x.omd mcsp_x.omd

# ------------------------------------------------------------------
# --- AXIS Y: opmode display path
# ------------------------------------------------------------------

net omd-y adapter_y.out-opmode-display => ut_y.omd mcsp_y.omd


# ------------------------------------------------------------------
# --- AXIS X: fault injector controls
# ------------------------------------------------------------------

newsig fi-inject-fault-x            bit
newsig fi-inject-fault-reaction-x   bit
newsig fi-inject-stall-x            bit
newsig fi-inject-response-timeout-x bit
newsig fi-inject-tracking-x         bit
newsig fi-reset-x                   bit

net fi-inject-fault-x            => fault_inj_x.inject-fault
net fi-inject-fault-reaction-x   => fault_inj_x.inject-fault-reaction
net fi-inject-stall-x            => fault_inj_x.inject-stall
net fi-inject-response-timeout-x => fault_inj_x.inject-response-timeout
net fi-inject-tracking-x         => fault_inj_x.inject-tracking
net fi-reset-x                   => fault_inj_x.reset

setp fault_inj_x.tracking-offset 2.5000
sets fi-inject-fault-x FALSE
sets fi-inject-fault-reaction-x FALSE
sets fi-inject-stall-x FALSE
sets fi-inject-response-timeout-x FALSE
sets fi-inject-tracking-x FALSE
sets fi-reset-x FALSE

# ------------------------------------------------------------------
# --- AXIS Y: fault injector controls
# ------------------------------------------------------------------

newsig fi-inject-fault-y            bit
newsig fi-inject-fault-reaction-y   bit
newsig fi-inject-stall-y            bit
newsig fi-inject-response-timeout-y bit
newsig fi-inject-tracking-y         bit
newsig fi-reset-y                   bit

net fi-inject-fault-y            => fault_inj_y.inject-fault
net fi-inject-fault-reaction-y   => fault_inj_y.inject-fault-reaction
net fi-inject-stall-y            => fault_inj_y.inject-stall
net fi-inject-response-timeout-y => fault_inj_y.inject-response-timeout
net fi-inject-tracking-y         => fault_inj_y.inject-tracking
net fi-reset-y                   => fault_inj_y.reset

setp fault_inj_y.tracking-offset 2.5000
sets fi-inject-fault-y FALSE
sets fi-inject-fault-reaction-y FALSE
sets fi-inject-stall-y FALSE
sets fi-inject-response-timeout-y FALSE
sets fi-inject-tracking-y FALSE
sets fi-reset-y FALSE

# ------------------------------------------------------------------
# --- AXIS X: motion watchdog
# ------------------------------------------------------------------

newsig motion-watchdog-fault-x    bit
newsig motion-watchdog-latched-x  bit
newsig motion-watchdog-response-x bit
newsig motion-watchdog-stall-x    bit
newsig motion-watchdog-trackerr-x bit
newsig motion-watchdog-code-x     u32
newsig motion-watchdog-reset-x    bit

net mcsp-ready-x              mcsp_x.ready => motion_wd_x.csp-ready invmon_x.csp-ready
net motion-watchdog-reset-x               => motion_wd_x.reset
net motion-watchdog-fault-x   motion_wd_x.fault
net motion-watchdog-latched-x motion_wd_x.fault-latched
net motion-watchdog-response-x motion_wd_x.response-timeout
net motion-watchdog-stall-x    motion_wd_x.stall
net motion-watchdog-trackerr-x motion_wd_x.tracking-error
net motion-watchdog-code-x     motion_wd_x.first-fault-code

setp motion_wd_x.movement-epsilon        0.0005
setp motion_wd_x.tracking-error-limit    0.2500
setp motion_wd_x.arm-delta-cycles        4
setp motion_wd_x.response-timeout-cycles 2000
setp motion_wd_x.stall-timeout-cycles    4000
sets motion-watchdog-reset-x FALSE

# ------------------------------------------------------------------
# --- AXIS Y: motion watchdog
# ------------------------------------------------------------------

newsig motion-watchdog-fault-y    bit
newsig motion-watchdog-latched-y  bit
newsig motion-watchdog-response-y bit
newsig motion-watchdog-stall-y    bit
newsig motion-watchdog-trackerr-y bit
newsig motion-watchdog-code-y     u32
newsig motion-watchdog-reset-y    bit

net mcsp-ready-y              mcsp_y.ready => motion_wd_y.csp-ready invmon_y.csp-ready
net motion-watchdog-reset-y               => motion_wd_y.reset
net motion-watchdog-fault-y   motion_wd_y.fault
net motion-watchdog-latched-y motion_wd_y.fault-latched
net motion-watchdog-response-y motion_wd_y.response-timeout
net motion-watchdog-stall-y    motion_wd_y.stall
net motion-watchdog-trackerr-y motion_wd_y.tracking-error
net motion-watchdog-code-y     motion_wd_y.first-fault-code

setp motion_wd_y.movement-epsilon        0.0005
setp motion_wd_y.tracking-error-limit    0.2500
setp motion_wd_y.arm-delta-cycles        4
setp motion_wd_y.response-timeout-cycles 2000
setp motion_wd_y.stall-timeout-cycles    4000
sets motion-watchdog-reset-y FALSE

# ------------------------------------------------------------------
# --- AXIS X: home watchdog
# ------------------------------------------------------------------

newsig home-watchdog-fault-x   bit
newsig home-watchdog-latched-x bit
newsig home-watchdog-code-x    u32
newsig home-watchdog-reset-x   bit

net home-watchdog-reset-x => home_wd_x.reset

net ut-owner-x        ut_x.owner    => mux_x.home-active invmon_x.home-owner home_wd_x.home-owner
net ut-homing-x       ut_x.homing   => mux_x.home-homing home_wd_x.homing
net ut-homed-x-sig    ut_x.homed    => home_wd_x.homed
net ut-done-lat-x-sig ut_x.done-lat => home_wd_x.done-lat
net ut-err-lat-x-sig  ut_x.err-lat  => home_wd_x.err-lat
net ut-mode-ok-x-sig  ut_x.mode-ok  => home_wd_x.mode-ok
net ut-state-x        ut_x.state    => invmon_x.ut-state home_wd_x.state
net ut-reason-x       ut_x.reason   => invmon_x.ut-reason home_wd_x.reason
net ut-mode-tmr-x-sig ut_x.mode-tmr => home_wd_x.mode-tmr
net ut-done-tmr-x-sig ut_x.done-tmr => home_wd_x.done-tmr
net ut-prog-tmr-x-sig ut_x.prog-tmr => home_wd_x.prog-tmr

net allow-homing-x => home_wd_x.enable

net home-watchdog-fault-x   home_wd_x.fault
net home-watchdog-latched-x home_wd_x.fault-latched
net home-watchdog-code-x    home_wd_x.first-fault-code

setp home_wd_x.owner-timeout-cycles 2000
setp home_wd_x.mode-timeout-limit   2000
setp home_wd_x.done-timeout-limit   120000
setp home_wd_x.prog-timeout-limit   10000
sets home-watchdog-reset-x FALSE

# ------------------------------------------------------------------
# --- AXIS Y: home watchdog
# ------------------------------------------------------------------

newsig home-watchdog-fault-y   bit
newsig home-watchdog-latched-y bit
newsig home-watchdog-code-y    u32
newsig home-watchdog-reset-y   bit

net home-watchdog-reset-y => home_wd_y.reset

net ut-owner-y        ut_y.owner    => mux_y.home-active invmon_y.home-owner home_wd_y.home-owner
net ut-homing-y       ut_y.homing   => mux_y.home-homing home_wd_y.homing
net ut-homed-y-sig    ut_y.homed    => home_wd_y.homed
net ut-done-lat-y-sig ut_y.done-lat => home_wd_y.done-lat
net ut-err-lat-y-sig  ut_y.err-lat  => home_wd_y.err-lat
net ut-mode-ok-y-sig  ut_y.mode-ok  => home_wd_y.mode-ok
net ut-state-y        ut_y.state    => invmon_y.ut-state home_wd_y.state
net ut-reason-y       ut_y.reason   => invmon_y.ut-reason home_wd_y.reason
net ut-mode-tmr-y-sig ut_y.mode-tmr => home_wd_y.mode-tmr
net ut-done-tmr-y-sig ut_y.done-tmr => home_wd_y.done-tmr
net ut-prog-tmr-y-sig ut_y.prog-tmr => home_wd_y.prog-tmr

net allow-homing-y => home_wd_y.enable

net home-watchdog-fault-y   home_wd_y.fault
net home-watchdog-latched-y home_wd_y.fault-latched
net home-watchdog-code-y    home_wd_y.first-fault-code

setp home_wd_y.owner-timeout-cycles 2000
setp home_wd_y.mode-timeout-limit   2000
setp home_wd_y.done-timeout-limit   120000
setp home_wd_y.prog-timeout-limit   10000
sets home-watchdog-reset-y FALSE

# ------------------------------------------------------------------
# --- AXIS X: semantic source signals for HOME
# ------------------------------------------------------------------

newsig home-om-x s32
newsig home-tp-x s32

net mux-sel-home-x mux_x.sel-home => invmon_x.sel-home
net mux-sel-csp-x  mux_x.sel-csp  => invmon_x.sel-csp

net mux-state-x  mux_x.state  => invmon_x.mux-state
net mux-reason-x mux_x.reason => invmon_x.mux-reason

net mcsp-state-x  mcsp_x.state  => invmon_x.mcsp-state
net mcsp-reason-x mcsp_x.reason => invmon_x.mcsp-reason
net mcsp-owner-x  mcsp_x.owner  => mux_x.csp-owner invmon_x.csp-owner

net home-om-x ut_x.om => mux_x.home-om
net home-tp-x ut_x.tp => mux_x.home-tp

# ------------------------------------------------------------------
# --- AXIS Y: semantic source signals for HOME
# ------------------------------------------------------------------

newsig home-om-y s32
newsig home-tp-y s32

net mux-sel-home-y mux_y.sel-home => invmon_y.sel-home
net mux-sel-csp-y  mux_y.sel-csp  => invmon_y.sel-csp

net mux-state-y  mux_y.state  => invmon_y.mux-state
net mux-reason-y mux_y.reason => invmon_y.mux-reason

net mcsp-state-y  mcsp_y.state  => invmon_y.mcsp-state
net mcsp-reason-y mcsp_y.reason => invmon_y.mcsp-reason
net mcsp-owner-y  mcsp_y.owner  => mux_y.csp-owner invmon_y.csp-owner

net home-om-y ut_y.om => mux_y.home-om
net home-tp-y ut_y.tp => mux_y.home-tp

# ------------------------------------------------------------------
# --- AXIS X: semantic source signals for CSP
# ------------------------------------------------------------------

newsig mcsp-om-x s32
newsig mcsp-tp-x s32

net mcsp-om-x mcsp_x.om => mux_x.csp-om
net mcsp-tp-x mcsp_x.tp => mux_x.csp-tp

# ------------------------------------------------------------------
# --- AXIS Y: semantic source signals for CSP
# ------------------------------------------------------------------

newsig mcsp-om-y s32
newsig mcsp-tp-y s32

net mcsp-om-y mcsp_y.om => mux_y.csp-om
net mcsp-tp-y mcsp_y.tp => mux_y.csp-tp

# ------------------------------------------------------------------
# --- AXIS X: final semantic writer -> backend
# ------------------------------------------------------------------

newsig om-x s32
newsig tp-x s32

net om-x mux_x.om => adapter_x.in-opmode
net tp-x mux_x.tp => adapter_x.in-target-position

# ------------------------------------------------------------------
# --- AXIS Y: final semantic writer -> backend
# ------------------------------------------------------------------

newsig om-y s32
newsig tp-y s32

net om-y mux_y.om => adapter_y.in-opmode
net tp-y mux_y.tp => adapter_y.in-target-position

# ------------------------------------------------------------------
# --- AXIS X: controlword composition
# ------------------------------------------------------------------

net start4-x   ut_x.start-out => cw_x.start4
net cw-final-x cw_x.cw-final  => adapter_x.in-controlword

# ------------------------------------------------------------------
# --- AXIS Y: controlword composition
# ------------------------------------------------------------------

net start4-y   ut_y.start-out => cw_y.start4
net cw-final-y cw_y.cw-final  => adapter_y.in-controlword

# ------------------------------------------------------------------
# --- AXIS X: setup
# ------------------------------------------------------------------

setp pds_x.enable      TRUE
setp pds_x.disable     FALSE
setp pds_x.quick-stop  FALSE

setp ut_x.scale             1000
setp ut_x.hold              TRUE
setp ut_x.done-m            0x1400
setp ut_x.done-v            0x1400
setp ut_x.err-m             0x0000
setp ut_x.err-v             0x0000
setp ut_x.start-pulse       1
setp ut_x.done-pulse-cycles 50

setp mcsp_x.scale    1000
setp fb_units_x.gain 0.001

# ------------------------------------------------------------------
# --- AXIS Y: setup
# ------------------------------------------------------------------

setp pds_y.enable      TRUE
setp pds_y.disable     FALSE
setp pds_y.quick-stop  FALSE

setp ut_y.scale             1000
setp ut_y.hold              TRUE
setp ut_y.done-m            0x1400
setp ut_y.done-v            0x1400
setp ut_y.err-m             0x0000
setp ut_y.err-v             0x0000
setp ut_y.start-pulse       1
setp ut_y.done-pulse-cycles 50

setp mcsp_y.scale    1000
setp fb_units_y.gain 0.001

# ------------------------------------------------------------------
# --- DEFAULT MACHINE POLICY / REQUESTS
# ------------------------------------------------------------------

sets estop-ok     TRUE
sets machine-on   TRUE
sets drives-ready TRUE

sets home-req-x        FALSE
sets motion-req-x      FALSE
sets fault-reset-req-x FALSE

sets home-req-y        FALSE
sets motion-req-y      FALSE
sets fault-reset-req-y FALSE
