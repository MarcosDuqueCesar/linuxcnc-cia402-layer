component machine_safety_gate "Generic machine policy gate for enable, homing, motion, and fault reset";

pin in  bit estop_ok         "Machine-level E-stop chain OK";
pin in  bit machine_on       "Machine power / machine-on request is active";
pin in  bit drives_ready     "Backend/drives are ready for operation";

pin in  bit homing_req       "Request to allow homing";
pin in  bit motion_req       "Request to allow motion";
pin in  bit fault_reset_req  "Request to allow fault reset";

pin out bit machine_ok       "True when machine policy allows progression";
pin out bit allow_enable     "True when enable is allowed";
pin out bit allow_homing     "True when homing is allowed";
pin out bit allow_motion     "True when motion is allowed";
pin out bit allow_fault_reset "True when fault reset is allowed";

pin out s32 reason           "Machine-policy diagnostic reason code";

function update;
license "MIT";

;;

enum {
    MSG_R_OK                      = 0,
    MSG_R_BLOCK_ESTOP             = 10,
    MSG_R_BLOCK_MACHINE_OFF       = 11,
    MSG_R_BLOCK_BACKEND_NOT_READY = 12
};

FUNCTION(update)
{
    machine_ok = 0;
    allow_enable = 0;
    allow_homing = 0;
    allow_motion = 0;
    allow_fault_reset = 0;
    reason = MSG_R_OK;

    if (!estop_ok) {
        reason = MSG_R_BLOCK_ESTOP;
        return;
    }

    if (!machine_on) {
        reason = MSG_R_BLOCK_MACHINE_OFF;
        return;
    }

    if (!drives_ready) {
        reason = MSG_R_BLOCK_BACKEND_NOT_READY;
        return;
    }

    machine_ok = 1;
    allow_enable = 1;
    allow_homing = homing_req ? 1 : 0;
    allow_motion = motion_req ? 1 : 0;
    allow_fault_reset = fault_reset_req ? 1 : 0;
    reason = MSG_R_OK;
}