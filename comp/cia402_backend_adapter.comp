component cia402_backend_adapter "Minimal CiA402 backend adapter (interface stabilizer)";

pin in  u32 in_controlword;
pin in  s32 in_opmode;
pin in  s32 in_target_position;

pin out u32 out_statusword;
pin out s32 out_opmode_display;
pin out s32 out_actual_position;

param rw float position_scale = 1.0;
param rw bit   passthrough_mode = TRUE;
param rw u32   homing_done_cycles = 50;

param rw bit   inject_fault = FALSE;
param rw s32   max_follow_delta = 20;

/* internal */
variable int st_ready;
variable int st_switched_on;
variable int st_op_enabled;
variable int st_fault;
variable int st_quick_stop;
variable int st_homing_done;
variable int st_voltage_enabled;
variable int st_target_reached;
variable int st_remote;

variable int last_tp;
variable int target_ap;
variable int homing_cnt;
variable int fault_latched;

function _;
license "GPL";
;;

FUNCTION(_) {
    if (!passthrough_mode) {
        homing_cnt = 0;
        out_opmode_display = 0;
        out_actual_position = 0;
        out_statusword = 0x0000;
        return;
    }

    if (inject_fault) {
        fault_latched = 1;
    }

    out_opmode_display = in_opmode;
    last_tp = in_target_position;
    target_ap = (int)(last_tp * position_scale);

    if (out_actual_position < (target_ap - max_follow_delta)) {
        out_actual_position += max_follow_delta;
    } else if (out_actual_position > (target_ap + max_follow_delta)) {
        out_actual_position -= max_follow_delta;
    } else {
        out_actual_position = target_ap;
    }

    st_fault = fault_latched;
    st_quick_stop = (in_controlword == 0x0002);
    st_homing_done = 0;

    st_ready = 1;
    st_switched_on = 1;
    st_op_enabled = 1;
    st_voltage_enabled = 1;
    st_target_reached = 1;
    st_remote = 1;

    if (st_fault) {
        homing_cnt = 0;
        out_statusword = 0x0008;

        if ((in_controlword == 0x0080) && !inject_fault) {
            fault_latched = 0;
            st_fault = 0;
        } else {
            out_statusword |= 0x0200;
            return;
        }
    }

    if (st_quick_stop) {
        homing_cnt = 0;
        st_op_enabled = 0;

        out_statusword = 0;
        if (st_ready)           out_statusword |= 0x0001;
        if (st_switched_on)     out_statusword |= 0x0002;
        if (st_quick_stop)      out_statusword |= 0x0004;
        if (st_voltage_enabled) out_statusword |= 0x0010;
        if (st_target_reached)  out_statusword |= 0x0200;
        return;
    }

    if (in_opmode == 6) {
        if (homing_cnt < homing_done_cycles) {
            homing_cnt++;
        } else {
            st_homing_done = 1;
        }
    } else {
        homing_cnt = 0;
    }

    out_statusword = 0;
    if (st_ready)           out_statusword |= 0x0001;
    if (st_switched_on)     out_statusword |= 0x0002;
    if (st_op_enabled)      out_statusword |= 0x0004;
    if (st_voltage_enabled) out_statusword |= 0x0010;
    if (st_remote)          out_statusword |= 0x0020;
    if (st_target_reached)  out_statusword |= 0x0200;
    if (st_homing_done)     out_statusword |= 0x1400;
}
