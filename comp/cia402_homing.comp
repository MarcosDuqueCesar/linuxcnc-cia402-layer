// === INVARIANT CONTRACT (V0.9.8.14) ===
// HOME ownership persists independently of Axis STOP
// fault removes execution capability, not semantic intent
// reset restores execution without redefining intent
// ======================================

component cia402_homing "CiA402 homing UT adapter (short names to satisfy HAL limits)";

pin in  bit   home;      // Execute request
pin in  bit   enable;    // Gating from PDS (OP_ENABLED)

pin in  float cmd;
pin in  float scale;
pin in  s32   ap;

pin in  u32   sw;
pin in  s32   omd;

pin out u32   cw;
pin out s32   om;
pin out s32   tp;

pin out bit   homing;
pin out bit   homed;
pin out bit   done_p;

param rw u32  done_m  = 0;
param rw u32  done_v  = 0;
param rw u32  err_m   = 0;
param rw u32  err_v   = 0;

param rw u32  start_pulse = 1;
param rw bit  hold        = 1;
param rw u32  done_pulse_cycles = 50;

/* Robustness / watchdogs (cycles in servo-thread units) */
param rw u32  mode_timeout_cycles     = 2000;
param rw u32  done_timeout_cycles     = 120000;
param rw u32  progress_timeout_cycles = 10000;
param rw u32  mode_confirm_cycles     = 1;

pin out s32   state;
pin out s32   reason;

pin out bit   exec_rise;
pin out bit   exec_fall;

pin out bit   start_out;
pin out bit   done_lat;
pin out bit   err_lat;
pin out bit   mode_ok;
pin out bit   owner;

pin out u32   mode_tmr;
pin out u32   done_tmr;
pin out u32   prog_tmr;

/* Per-instance runtime state */
variable hal_bit_t  homed_old;
variable hal_u32_t  start_cnt;
variable hal_bit_t  exec_prev;
variable hal_bit_t  start_sent;
variable hal_bit_t  done_latched;
variable hal_bit_t  err_latched;
variable hal_u32_t  done_p_cnt;

variable hal_u32_t  wait_mode_cnt;
variable hal_u32_t  wait_done_cnt;
variable hal_u32_t  progress_cnt;
variable hal_u32_t  omd_ok_cnt;

variable hal_s32_t  last_ap;
variable hal_u32_t  last_sw;
variable hal_s32_t  last_omd;
variable hal_bit_t  progress_init;

function update;
license "MIT";

;;

#include <stdint.h>

enum {
    H_S_IDLE              = 0,
    H_S_WAIT_OMD6         = 10,
    H_S_SEND_START        = 11,
    H_S_WAIT_DONE         = 12,
    H_S_DONE              = 13,
    H_S_ERROR             = 15
};

enum {
    H_R_IDLE                      = 0,
    H_R_WAITING_MODE_DISPLAY      = 10,
    H_R_SENDING_START_PULSE       = 11,
    H_R_WAITING_DONE              = 12,
    H_R_DONE                      = 13,

    H_R_ERROR_STATUS_MATCH        = 20,
// NOTE: execution drop != intent removal (intent persists upstream)
    H_R_ERROR_EXEC_DROPPED        = 21,
    H_R_ERROR_INVALID_STATE       = 22,
    H_R_ERROR_MODE_TIMEOUT        = 23,
    H_R_ERROR_DONE_TIMEOUT        = 24,
    H_R_ERROR_PROGRESS_TIMEOUT    = 25,
    H_R_ERROR_MODE_LOST           = 26
};

static inline int bit_is_set_u32(uint32_t v, int bit)
{
    return (v >> bit) & 1u;
}

static void reset_runtime_state(struct __comp_state *__comp_inst)
{
    start_cnt      = 0;
    start_sent     = 0;
    done_latched   = 0;
    err_latched    = 0;
    homed_old      = 0;
    done_p_cnt     = 0;

    wait_mode_cnt  = 0;
    wait_done_cnt  = 0;
    progress_cnt   = 0;
    omd_ok_cnt     = 0;
    progress_init  = 0;
}

static void reset_progress_watch(struct __comp_state *__comp_inst,
                                 int32_t ap_now,
                                 uint32_t sw_now,
                                 int32_t omd_now)
{
    progress_cnt  = 0;
    last_ap       = ap_now;
    last_sw       = sw_now;
    last_omd      = omd_now;
    progress_init = 1;
}

FUNCTION(update)
{
    (void)period;

    /* Effective Execute = home AND enable */
    int exec = (home && enable);

    cw = 0;
    om = 8;

    exec_rise = 0;
    exec_fall = 0;
    start_out = 0;
    mode_ok   = 0;
    owner     = 0;

    if (hold && exec) {
        tp = ap;
    } else {
        float s = (scale != 0.0f) ? scale : 1.0f;
        tp = (int32_t)(cmd * s);
    }

    if (exec) {
        om = 6;
    }

    {
        int exec_rise_local = (exec && !exec_prev);
        int exec_fall_local = (!exec && exec_prev);
        exec_prev = exec ? 1 : 0;

        exec_rise = exec_rise_local ? 1 : 0;
        exec_fall = exec_fall_local ? 1 : 0;

        if (exec_fall_local) {
            reset_runtime_state(__comp_inst);

            err_latched = 1;
            homed       = 0;
            homing      = 0;
            done_p      = 0;
            done_lat    = 0;
            err_lat     = 1;
            mode_ok     = 0;
            owner       = 0;
            mode_tmr    = 0;
            done_tmr    = 0;
            prog_tmr    = 0;

            state       = H_S_ERROR;
// NOTE: execution drop != intent removal (intent persists upstream)
            reason      = H_R_ERROR_EXEC_DROPPED;
            return;
        }

        if (!exec) {
            reset_runtime_state(__comp_inst);

            homed       = 0;
            homing      = 0;
            done_p      = 0;
            done_lat    = 0;
            err_lat     = 0;
            mode_ok     = 0;
            owner       = 0;
            mode_tmr    = 0;
            done_tmr    = 0;
            prog_tmr    = 0;

            state       = H_S_IDLE;
            reason      = H_R_IDLE;
            return;
        }

        if (exec_rise_local) {
            reset_runtime_state(__comp_inst);
            state  = H_S_WAIT_OMD6;
            reason = H_R_WAITING_MODE_DISPLAY;
        }
    }

    if (state == H_S_IDLE) {
        state  = H_S_WAIT_OMD6;
        reason = H_R_WAITING_MODE_DISPLAY;
    }

    {
        int done_match = 0;
        int err_match  = 0;

        if (omd == 6) {
            uint32_t st = sw;

            if (done_m != 0) {
                done_match = ((st & done_m) == done_v);
                err_match  = (err_m != 0) ? ((st & err_m) == err_v) : 0;
            } else {
                done_match = bit_is_set_u32(st, 10) && bit_is_set_u32(st, 12);
                err_match  = 0;
            }
        }

        switch (state) {

        case H_S_WAIT_OMD6:
            reason = H_R_WAITING_MODE_DISPLAY;

            if (omd == 6) {
                omd_ok_cnt++;
                if (omd_ok_cnt >= ((mode_confirm_cycles == 0) ? 1u : mode_confirm_cycles)) {
                    mode_ok = 1;
                    reset_progress_watch(__comp_inst, ap, sw, omd);
                    state = H_S_SEND_START;
                }
            } else {
                omd_ok_cnt = 0;
                if (mode_timeout_cycles != 0) {
                    wait_mode_cnt++;
                    if (wait_mode_cnt >= mode_timeout_cycles) {
                        state       = H_S_ERROR;
                        err_latched = 1;
                        reason      = H_R_ERROR_MODE_TIMEOUT;
                    }
                }
            }
            break;

        case H_S_SEND_START:
            reason  = H_R_SENDING_START_PULSE;
            mode_ok = (omd == 6) ? 1 : 0;

            if (omd != 6) {
                state       = H_S_ERROR;
                err_latched = 1;
                reason      = H_R_ERROR_MODE_LOST;
                break;
            }

            if (!start_sent && !done_latched && !err_latched) {
                if (start_cnt < start_pulse) {
                    start_out = 1;
                    start_cnt++;
                    if (start_cnt >= start_pulse) {
                        start_sent = 1;
                    }
                } else {
                    start_sent = 1;
                }
            }

            if (start_sent) {
                reset_progress_watch(__comp_inst, ap, sw, omd);
                state = H_S_WAIT_DONE;
            }
            break;

        case H_S_WAIT_DONE:
            reason  = H_R_WAITING_DONE;
            mode_ok = (omd == 6) ? 1 : 0;

            if (omd != 6) {
                state       = H_S_ERROR;
                err_latched = 1;
                reason      = H_R_ERROR_MODE_LOST;
                break;
            }

            if (!err_latched && err_match) {
                err_latched = 1;
                state = H_S_ERROR;
                reason = H_R_ERROR_STATUS_MATCH;
                break;
            }

            /* DONE has final precedence once detected */
            if (!done_latched && start_sent && done_match && !err_match) {
                done_latched = 1;
                err_latched  = 0;
                state        = H_S_DONE;
                reason       = H_R_DONE;
                break;
            }

            if (!progress_init) {
                reset_progress_watch(__comp_inst, ap, sw, omd);
            } else {
                if (ap != last_ap || sw != last_sw || omd != last_omd) {
                    reset_progress_watch(__comp_inst, ap, sw, omd);
                } else if (!done_latched && progress_timeout_cycles != 0) {
                    progress_cnt++;
                    if (progress_cnt >= progress_timeout_cycles) {
                        state       = H_S_ERROR;
                        err_latched = 1;
                        reason      = H_R_ERROR_PROGRESS_TIMEOUT;
                        break;
                    }
                }
            }

            if (!done_latched && done_timeout_cycles != 0) {
                wait_done_cnt++;
                if (wait_done_cnt >= done_timeout_cycles) {
                    state       = H_S_ERROR;
                    err_latched = 1;
                    reason      = H_R_ERROR_DONE_TIMEOUT;
                    break;
                }
            }

            break;

        case H_S_DONE:
            reason  = H_R_DONE;
            mode_ok = (omd == 6) ? 1 : 0;
            err_latched = 0;
            break;

        case H_S_ERROR:
            done_latched = 0;
            if (!err_latched) {
                err_latched = 1;
            }
            if (reason != H_R_ERROR_STATUS_MATCH &&
// NOTE: execution drop != intent removal (intent persists upstream)
                reason != H_R_ERROR_EXEC_DROPPED &&
                reason != H_R_ERROR_INVALID_STATE &&
                reason != H_R_ERROR_MODE_TIMEOUT &&
                reason != H_R_ERROR_DONE_TIMEOUT &&
                reason != H_R_ERROR_PROGRESS_TIMEOUT &&
                reason != H_R_ERROR_MODE_LOST) {
                reason = H_R_ERROR_INVALID_STATE;
            }
            break;

        default:
            done_latched = 0;
            state  = H_S_ERROR;
            err_latched = 1;
            reason = H_R_ERROR_INVALID_STATE;
            break;
        }
    }

    homed  = (done_latched && !err_latched) ? 1 : 0;
    homing = (exec && !done_latched && !err_latched) ? 1 : 0;

    owner = ((state != H_S_IDLE) && (state != H_S_ERROR)) ? 1 : 0;

    done_lat = done_latched ? 1 : 0;
    err_lat  = err_latched ? 1 : 0;

    mode_tmr = wait_mode_cnt;
    done_tmr = wait_done_cnt;
    prog_tmr = progress_cnt;

    if (homed && !homed_old) {
        uint32_t n = done_pulse_cycles;
        if (n == 0) n = 1;
        done_p_cnt = n;
    }

    if (done_p_cnt > 0) {
        done_p = 1;
        done_p_cnt--;
    } else {
        done_p = 0;
    }

    homed_old = homed ? 1 : 0;
}
